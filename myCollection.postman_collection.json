    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = Date.now();\r",
              "\r",
              "pm.environment.set(\"firstName\", `User${timestamp}`);\r",
              "pm.environment.set(\"email\", `user${timestamp}@gmail.com`);\r",
              "pm.environment.set(\"username\", `user${timestamp}`);\r",
              "pm.environment.set(\"password\", `Password${timestamp}!`);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"first_name\": \"{{firstName}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"username\": \"{{username}}\",\r\n  \"password\": \"{{password}}\",\r\n  \"role_id\": 2,\r\n  \"account\": 100\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/register/api",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register",
            "api"
          ]
        }
      },
      "response": []
    },
