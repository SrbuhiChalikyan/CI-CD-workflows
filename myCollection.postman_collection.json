    {
      "name": "Get newly added advanced course",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "const courses = response.result;\r",
              "\r",
              "const courseId = Number(pm.environment.get(\"courseId\"));\r",
              "\r",
              "pm.test(\"Created course exists\", function () {\r",
              "    const courseExists = courses.some(course => course.id === courseId);\r",
              "    pm.expect(courseExists).to.be.true;\r",
              "});"
